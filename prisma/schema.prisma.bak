
generator client {

  provider = "prisma-client-js"

}



datasource db {

  provider = "postgresql"

  url      = env("DATABASE_URL")

}



model User {

  id        String   @id @default(cuid())

  email     String   @unique

  password  String

  name      String

  phone     String?

  role      String   @default("CLIENT")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt



  orders    Order[]

  favorites Favorite[]

  equipment Equipment[]

  supplier  Supplier?

}



model Supplier {

  id          String   @id @default(cuid())

  userId      String   @unique

  user        User     @relation(fields: [userId], references: [id])

  companyName String

  description String?

  rating      Float    @default(0)

  reviewCount Int      @default(0)

  phone       String?

  email       String?

  logo        String?

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt



  equipment   Equipment[]

}



model Equipment {

  id          String   @id @default(cuid())

  name        String

  description String?

  price       Float

  deposit     Float?

  images      String[]

  quantity    Int      @default(1)

  available   Int      @default(1)

  city        String

  deliveryAvailable Boolean @default(false)

  rating      Float    @default(0)

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt



  userId      String

  user        User     @relation(fields: [userId], references: [id])



  supplierId  String?

  supplier    Supplier? @relation(fields: [supplierId], references: [id])



  orderItems  OrderItem[]

  favorites   Favorite[]

}



model Order {

  id           String   @id @default(cuid())

  userId       String

  user         User     @relation(fields: [userId], references: [id])

  status       String   @default("CREATED")

  totalPrice   Float

  eventType    String?

  eventDate    DateTime?

  eventCity    String?

  createdAt    DateTime @default(now())

  updatedAt    DateTime @updatedAt



  items        OrderItem[]

}



model OrderItem {

  id          String    @id @default(cuid())

  orderId     String

  order       Order     @relation(fields: [orderId], references: [id])

  equipmentId String

  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  quantity    Int

  priceAtTime Float

  startDate   DateTime

  endDate     DateTime

}



model Favorite {

  id          String    @id @default(cuid())

  userId      String

  user        User      @relation(fields: [userId], references: [id])

  equipmentId String

  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  createdAt   DateTime  @default(now())



  @@unique([userId, equipmentId])

}




// Добавляем в модель Equipment после userId

  supplierId  String?

  supplier    Supplier? @relation(fields: [supplierId], references: [id])

